# Copy this file to ".env" and fill in your values.
# NEVER commit the real .env (it is git-ignored).

# --- Price data provider ---
# yahoo   : no API key, includes per-minute volume (unofficial endpoint, best for V1)
# finnhub : needs FINNHUB_API_KEY, price only on the free tier (no volume)
# sim     : synthetic data generator, for testing detection without any network/keys
PRICE_PROVIDER=yahoo

# Finnhub API key (only needed if PRICE_PROVIDER=finnhub). Get one at https://finnhub.io
FINNHUB_API_KEY=

# --- Telegram notifications ---
# 1. Create a bot with @BotFather -> you get a token like 123456:ABC-DEF...
# 2. Send any message to your new bot, then read your chat id (see README "Telegram setup").
# If either value is empty, alerts fall back to console logging only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- News (optional, V2) ---
ENABLE_NEWS=false

# --- Misc ---
DATABASE_PATH=market_alert.db
LOG_LEVEL=INFO
